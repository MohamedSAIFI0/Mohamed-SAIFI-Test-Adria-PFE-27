type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String!
}

type TransferResult {
    debit: Transaction!
    credit: Transaction!
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
}

input TransferInput {
    fromAccountId: ID!
    toAccountId: ID!
    amount: Float!
    currency: String!
    country: String
}

type Query {
    transactionById(id: ID!): Transaction
    transactionsByAccount(accountId: ID!): [Transaction!]!
}

type Mutation {
    createTransaction(input: TransactionInput!): Transaction!
    transfer(input: TransferInput!): TransferResult!
}
